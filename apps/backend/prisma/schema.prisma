generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ============ KYRA ============

model Bug {
  id             Int     @id @default(autoincrement())
  name           String
  scientificName String?
  category       String
}


// --- MICHAEL'S TABLE ---
model CollectedBug {
  id             Int      @id @default(autoincrement())
  userId         Int
  commonName     String
  scientificName String
  order          String
  habitat        String
  dateCollected  DateTime
}

// ============ ZACH ============