generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ============ KYRA ============

model Bug {
  id             Int     @id @default(autoincrement())
  name           String
  scientificName String?
  category       String
  CollectedBugs  CollectedBug[]
}


// --- MICHAEL'S TABLE ---
model User {
  id             Int      @id @default(autoincrement())
  name           String
  CollectedBugs  CollectedBug[]
}

model CollectedBug {
  id             Int      @id @default(autoincrement())
  userId         Int
  bugId          Int
  dateCollected DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  bug  Bug  @relation(fields: [bugId], references: [id])

  @@unique([userId, bugId])
}

// ============ ZACH ============