generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- MICHAEL'S TABLE ---
model CollectedBug {
  id             Int      @id @default(autoincrement())
  userId         Int
  commonName     String
  scientificName String
  order          String
  habitat        String
  dateCollected  DateTime
}